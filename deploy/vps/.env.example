# Public hostname pointed to this VPS, e.g. ai.example.com
KHASROY_DOMAIN=localhost

# Owner authentication
KHASROY_OWNER_KEY=change-me

# Primary text/vision provider currently used by Khasroy
GROQ_API_KEY=

# Optional memory overrides. Existing Supabase endpoint/key defaults are already in code.
# KHASROY_MEMORY_ENDPOINT=
# KHASROY_SUPABASE_PUBLISHABLE_KEY=

# Optional image provider configuration. Vercel AI Gateway is no longer required for hosting.
# AI_GATEWAY_API_KEY=
# KHASROY_IMAGE_GENERATION_MODEL=
# KHASROY_IMAGE_AUDITOR_MODEL=
