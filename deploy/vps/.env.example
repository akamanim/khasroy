# Public hostname pointed to this VPS, e.g. ai.example.com
KHASROY_DOMAIN=localhost

# Owner authentication
KHASROY_OWNER_KEY=change-me

# Multi-teacher text providers. Configure any subset; Khasroy routes and falls back automatically.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
# KIMI_API_KEY= # alias if MOONSHOT_API_KEY is not used

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# KHASROY_OPENAI_MODEL=gpt-5.6-terra
# KHASROY_GEMINI_MODEL=gemini-3.5-flash
# KHASROY_KIMI_MODEL=kimi-k2.6

# Router controls: one provider is tried for simple cases; failures can fall through to others.
# KHASROY_PROVIDER_TIMEOUT_MS=16000
# KHASROY_TEACHER_MAX_ATTEMPTS=3

# Optional memory overrides. Existing Supabase endpoint/key defaults are already in code.
# KHASROY_MEMORY_ENDPOINT=
# KHASROY_SUPABASE_PUBLISHABLE_KEY=
# KHASROY_WEB_STUDIO_ENDPOINT=

# Turnkey Web Studio publishing.
# GitHub token needs permission to create repositories and write their contents.
KHASROY_GITHUB_TOKEN=
# Vercel token needs project/deployment permissions. Team ID is optional for personal accounts.
KHASROY_VERCEL_TOKEN=
# KHASROY_VERCEL_TEAM_ID=

# Instagram Graph API publishing. Drafting/queueing works without these.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# INSTAGRAM_GRAPH_VERSION=v24.0

# Optional image provider configuration. Vercel AI Gateway is no longer required for hosting.
# AI_GATEWAY_API_KEY=
# KHASROY_IMAGE_GENERATION_MODEL=
# KHASROY_IMAGE_AUDITOR_MODEL=
